{
  "version": 2,
  "name": "nexus-qa-platform",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tester", "destination": "/tester.html" },
    { "source": "/qa", "destination": "/tester.html" },
    { "source": "/dev", "destination": "/dev.html" },
    { "source": "/developer", "destination": "/dev.html" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
